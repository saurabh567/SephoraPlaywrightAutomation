ENV=dev
TEST_PLATFORM=IOS
IOS_AUTOMATION_MODE=SAFARI
APP_NAME=Amazon India Safari
REPORT_DIR=reports/ios
TIMEOUT=180000
RETRIES=0
PARALLEL=1
APPIUM_PROTOCOL=http
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/
APPIUM_PATH=/
APPIUM_LOG_LEVEL=info
APPIUM_AUTO_START=true
APPIUM_AUTO_STOP=false
APPIUM_START_TIMEOUT=30000
APPIUM_CONNECTION_RETRY_TIMEOUT=180000
APPIUM_CONNECTION_RETRY_COUNT=3
APPIUM_LOG_PATH=mobile/logs/appium-server.log
DEVICE_NAME=iPhone 17 Pro Max
PLATFORM_VERSION=26.4
UDID=7AA50263-76AB-4CDF-9ED2-2F073C92A17D
BROWSER_NAME=Safari
APP_PATH=
BUNDLE_ID=com.apple.mobilesafari
APP_ID_KEY=com.apple.mobilesafari

# ── PERFORMANCE: Keep simulator & Appium alive between runs ────────────────
# Prevents cold boot of simulator (saves 30-60s per run)
KEEP_IOS_SIMULATOR=true
KEEP_APPIUM_SERVER=true

# ── PERFORMANCE: Reuse cached WDA build ─────────────────────────────────────
# Once WDA is compiled for current Xcode, rebuilding every session wastes 30-60s
USE_NEW_WDA=false

# ── SESSION RESET: Let Appium handle Safari lifecycle ──────────────────────
# NO_RESET=false + safari:clearData=true tells Appium to terminate Safari
# and start fresh each session. This is FAST because simulator is already
# booted and WDA is already compiled (2-3s vs 60s+ cold start).
NO_RESET=false
FULL_RESET=false

NEW_COMMAND_TIMEOUT=120
XCODE_ORG_ID=
XCODE_SIGNING_ID=
UPDATED_WDA_BUNDLE_ID=
WDA_LOCAL_PORT=
WDA_LAUNCH_TIMEOUT=180000
WDA_CONNECTION_TIMEOUT=180000
AUTO_ACCEPT_ALERTS=true
AUTO_DISMISS_ALERTS=false
SHOW_XCODE_LOG=true
IOS_SIMULATOR_NAME=iPhone 17 Pro Max
CLEAR_IOS_SAFARI_DATA=true
