ENV=dev
TEST_PLATFORM=IOS
IOS_AUTOMATION_MODE=SAFARI
APP_NAME=Amazon India Safari
REPORT_DIR=reports/ios
TIMEOUT=180000
RETRIES=0
PARALLEL=1
APPIUM_PROTOCOL=http
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/
APPIUM_PATH=/
APPIUM_LOG_LEVEL=info
APPIUM_AUTO_START=true
APPIUM_AUTO_STOP=true
APPIUM_START_TIMEOUT=30000
APPIUM_CONNECTION_RETRY_TIMEOUT=180000
APPIUM_CONNECTION_RETRY_COUNT=3
APPIUM_LOG_PATH=mobile/logs/appium-server.log
DEVICE_NAME=iPhone 17 Pro Max
PLATFORM_VERSION=26.4
UDID=7AA50263-76AB-4CDF-9ED2-2F073C92A17D
BROWSER_NAME=Safari
APP_PATH=
BUNDLE_ID=com.apple.mobilesafari

# appIdKey: Required by Appium for certain iOS operations.
# Can be same as BUNDLE_ID or a separate identifier.
APP_ID_KEY=com.apple.mobilesafari

# Reset / fresh state — ensures every test starts with clean browser cache
NO_RESET=false
FULL_RESET=false

NEW_COMMAND_TIMEOUT=120
XCODE_ORG_ID=
XCODE_SIGNING_ID=
UPDATED_WDA_BUNDLE_ID=
WDA_LOCAL_PORT=
WDA_LAUNCH_TIMEOUT=180000
WDA_CONNECTION_TIMEOUT=180000

# Use new WDA build for current Xcode version; set false only if cached build is verified compatible
USE_NEW_WDA=true

AUTO_ACCEPT_ALERTS=true
AUTO_DISMISS_ALERTS=false
SHOW_XCODE_LOG=true

# iOS lifecycle control
KEEP_IOS_SIMULATOR=false
KEEP_APPIUM_SERVER=false
IOS_SIMULATOR_NAME=iPhone 17 Pro Max
