{
  "name": "amazonwebmobileplaywrightautomation",
  "displayName": "AMAZONWEBMOBILEPLAYWRIGHTAUTOMATION",
  "version": "1.0.0",
  "description": "Industry-standard Playwright JavaScript Cucumber BDD automation framework for Amazon India UI. Includes JMeter performance testing with AI analysis and API automation module.",
  "main": "index.js",
  "scripts": {
    "pretest": "node --import tsx utils/cleanReports.ts",
    "test": "node --import tsx utils/runCucumberWithAi.ts",
    "pretest:core": "node --import tsx utils/cleanReports.ts",
    "test:core": "cucumber-js --config cucumber.js",
    "appium:start": "node --import tsx ai/agents/AppiumAgent.ts start",
    "appium:stop": "node --import tsx ai/agents/AppiumAgent.ts stop",
    "appium:status": "node --import tsx ai/agents/AppiumAgent.ts status",
    "pretest:web": "node --import tsx utils/cleanReports.ts --platform web",
    "test:web": "TEST_PLATFORM=WEB REPORT_DIR=reports/web cucumber-js --config cucumber.js --tags @web --format summary; node --import tsx utils/generateReports.ts web",
    "pretest:android": "node --import tsx utils/cleanReports.ts --platform android",
    "test:android": "node --import tsx mobile/runAndroidWithOrchestrator.ts",
    "test:android:legacy": "node --import tsx utils/runAndroidWithLifecycle.ts; node --import tsx utils/generateReports.ts android",
    "test:android:raw": "ENV_FILE=.env.android REPORT_DIR=reports/android PARALLEL=1 cucumber-js --config cucumber.android.js --tags @android --retry 1 --format summary",
    "pretest:ios": "node --import tsx utils/cleanReports.ts --platform ios",
    "test:ios": "node --import tsx mobile/runIOSWithOrchestrator.ts",
    "test:ios:legacy": "node --import tsx utils/runIOSWithLifecycle.ts; node --import tsx utils/generateReports.ts ios",
    "test:all": "node --import tsx utils/runAllPlatforms.ts",
    "test:ios:raw": "ENV_FILE=.env.ios REPORT_DIR=reports/ios PARALLEL=1 cucumber-js --config cucumber.js --tags @ios --format summary",
    "pretest:ai": "node --import tsx utils/cleanReports.ts",
    "test:ai": "node --import tsx utils/runCucumberWithAi.ts",
    "pretest:parallel": "node --import tsx utils/cleanReports.ts",
    "test:parallel": "PARALLEL=4 cucumber-js --config cucumber.js",
    "pretest:parallel:2": "node --import tsx utils/cleanReports.ts",
    "test:parallel:2": "PARALLEL=2 cucumber-js --config cucumber.js",
    "test:cross-browser": "node --import tsx utils/runCrossBrowser.ts",
    "test:cross-browser:smoke": "BROWSERS=chromium,firefox,webkit TAGS=@smoke node --import tsx utils/runCrossBrowser.ts",
    "test:home": "cucumber-js --config cucumber.js features/home.feature",
    "test:smoke": "cucumber-js --config cucumber.js --tags @smoke",
    "test:regression": "cucumber-js --config cucumber.js --tags @regression",
    "test:login": "cucumber-js --config cucumber.js --tags @login",
    "test:search-results": "cucumber-js --config cucumber.js features/search_results.feature",
    "test:cart": "cucumber-js --config cucumber.js features/cart.feature",
    "test:product": "cucumber-js --config cucumber.js features/product_details.feature",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "pretest:playwright:cli": "node --import tsx utils/cleanReports.ts",
    "test:playwright:cli": "PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.ts",
    "test:playwright:cli:headed": "HEADLESS=false PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.ts --headed",
    "test:playwright:cli:ci": "CI=true PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.ts",
    "test:playwright:cli:debug": "PWDEBUG=1 PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.ts --headed --timeout 300000",
    "test:playwright:cli:smoke": "TAGS=@smoke PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.ts --grep @smoke",
    "test:playwright:cli:ai": "PLAYWRIGHT_CLI=true node --import tsx utils/runCucumberWithAi.ts",
    "test:playwright:cli:orchestrate": "PLAYWRIGHT_CLI=true node --import tsx ai/orchestrator/unifiedOrchestrator.ts --playwright-cli",
    "pretest:api": "node --import tsx -e \"require('fs-extra').ensureDirSync('reports/api'); require('fs-extra').ensureDirSync('reports/ai');\"",
    "test:api": "cucumber-js --config cucumber.api.js",
    "test:api:report": "node --import tsx -e \"const fs=require(\\\"fs-extra\\\");const p=require(\\\"path\\\");const files=[\\\"reports/api/api-summary.json\\\",\\\"reports/api/api-summary.md\\\",\\\"reports/api/api-report.html\\\",\\\"reports/ai/api-analysis-report.md\\\"];console.log(\\\"\\\\n=== API Reports ===\\\");let all=true;files.forEach(f=>{const ok=fs.existsSync(f);console.log((ok?\\\"✅\\\":\\\"❌\\\")+\\\" \\\"+f+(ok?\\\" (\\\"+fs.statSync(f).size+\\\" bytes)\\\":\\\" (MISSING)\\\"));});if(all){try{const j=JSON.parse(fs.readFileSync(\\\"reports/api/api-summary.json\\\"));console.log(\\\"\\\\nTotal: \\\"+j.totalAPIs+\\\" | Passed: \\\"+j.passed+\\\" | Failed: \\\"+j.failed+\\\" | Pass%: \\\"+j.passRate);}catch(e){console.log(\\\"\\\\nCould not parse summary JSON\\\");}}console.log(\\\"\\\");\"",
    "test:all:with-api": "node --import tsx utils/runAllPlatforms.ts",
    "report": "node --import tsx utils/generateReport.ts",
    "report:web": "node --import tsx utils/generateReports.ts web",
    "report:android": "node --import tsx utils/generateReports.ts android",
    "report:ios": "node --import tsx utils/generateReports.ts ios",
    "report:all": "node --import tsx utils/generateReports.ts all",
    "validate:migration": "node --import tsx utils/validateMigrationReferences.ts",
    "vector:start": "node --import tsx ai/vector-db/startChroma.ts",
    "vector:stop": "node --import tsx ai/vector-db/chromaServerManager.ts stop",
    "vector:health": "node --import tsx ai/health/unifiedHealth.ts",
    "vector:ingest": "node --import tsx ai/vector-db/ingest.ts",
    "vector:search": "node --import tsx ai/vector-db/search.ts",
    "vector:test": "node --import tsx ai/vector-db/vectorTest.ts",
    "rag:test": "node --import tsx ai/local/localRagTest.ts",
    "ai:test": "node --import tsx ai/vector-db/aiTest.ts",
    "ai:analyze-failures": "node --import tsx ai/local/localAnalyzeFailures.ts",
    "ollama:start": "node --import tsx ai/health/ollamaManager.ts start",
    "ollama:stop": "node --import tsx ai/health/ollamaManager.ts stop",
    "ollama:status": "node --import tsx ai/health/ollamaManager.ts status",
    "ollama:pull-embed": "node --import tsx -e \"require('./ai/health/ollamaManager').pullModelSync(process.env.OLLAMA_EMBEDDING_MODEL||'nomic-embed-text')\"",
    "ollama:pull-llm": "node --import tsx -e \"require('./ai/health/ollamaManager').pullModelSync(process.env.OLLAMA_LLM_MODEL||'llama3.2:3b')\"",
    "ai:generate-tests": "node --import tsx ai/vector-db/generateTests.ts",
    "ai:heal-locators": "node --import tsx ai/vector-db/healLocators.ts",
    "ai:jenkins-rag": "node --import tsx ai/vector-db/analyzeJenkinsFailure.ts",
    "ai:testcases": "node --import tsx ai/index.ts --agent TestCaseGenerationAgent",
    "ai:feature": "node --import tsx ai/index.ts --agent FeatureFileGenerationAgent",
    "ai:steps": "node --import tsx ai/index.ts --agent StepDefinitionGenerationAgent",
    "ai:page": "node --import tsx ai/index.ts --agent PageObjectGenerationAgent",
    "ai:jenkins": "node --import tsx ai/index.ts --agent JenkinsBuildFailureAnalysisAgent",
    "ai:review": "node --import tsx ai/index.ts --agent PlaywrightCodeReviewAgent",
    "ai:heal": "node --import tsx ai/index.ts --agent SelfHealingAutomationAgent",
    "ai:all": "node --import tsx ai/index.ts --all",
    "ai:orchestrate": "node --import tsx ai/orchestrator/unifiedOrchestrator.ts",
    "ai:orchestrate:full": "node --import tsx ai/orchestrator/unifiedOrchestrator.ts --force-full",
    "ai:orchestrate:analysis": "node --import tsx ai/orchestrator/unifiedOrchestrator.ts --skip-multi-agent --skip-reporting",
    "ai:orchestrate:legacy": "node --import tsx ai/orchestrator/orchestrator.ts",
    "ai:full-auto": "node --import tsx ai/orchestrator/fullAuto.ts",
    "heal:locators": "node -r ts-node/register utils/runLocatorHealing.ts",
    "heal:locators:apply": "node -r ts-node/register utils/runLocatorHealing.ts --mode apply",
    "heal:locators:dry": "node -r ts-node/register utils/runLocatorHealing.ts --mode dry-run",
    "ai:self-heal": "node --import tsx -e \"(async()=>{const a=require('./ai/agents/locatorHealingAgent'); if(a.run) {console.log(await a.run());} else if(a.suggestWithRag){console.log(await a.suggestWithRag());}})()\"",
    "ai:retry-fix-rerun": "node --import tsx -e \"(async()=>{const a=require('./ai/agents/selfHealingAutomationAgent'); if(a.run){console.log(await a.run());} else {console.log('no-op');}})()\"",
    "ai:root-cause": "node --import tsx -e \"(async()=>{const a=require('./ai/agents/rootCauseAnalysisAgent'); if(a.run){console.log(await a.run());} else {console.log('no-op');}})()\"",
    "ai:prepare-pr": "node --import tsx -e \"(async()=>{const a=require('./ai/agents/prPreparationAgent'); if(a.prepare){console.log(await a.prepare({}));} else {console.log('no-op');}})()\"",
    "ai:jenkins-recover": "node --import tsx -e \"(async()=>{const a=require('./ai/agents/jenkinsBuildFailureAnalysisAgent'); if(a.analyze){console.log(await a.analyze());} else {console.log('no-op');}})()\"",
    "chroma:start": "node --import tsx ai/vector-db/chromaServerManager.ts start",
    "chroma:stop": "node --import tsx ai/vector-db/chromaServerManager.ts stop",
    "chroma:status": "node --import tsx ai/vector-db/chromaServerManager.ts status",
    "perf:jmeter": "node --import tsx scripts/runJMeter.ts",
    "perf:jmeter:gui": "node --import tsx scripts/runJMeter.ts --gui",
    "perf:jmeter:kill": "pkill -f ApacheJMeter || true; pkill -f jmeter || true",
    "perf:jmeter:html": "node --import tsx -e \"const p=require('path');const f=p.join(__dirname,'reports','jmeter','html','index.html');console.log('JMeter HTML report: '+f);\"",
    "ai:jmeter-analysis": "node --import tsx ai/agents/jmeterPerformanceAnalysisAgent.ts",
    "dashboard:generate": "node --import tsx utils/runDashboard.ts",
    "dashboard:open": "node --import tsx -e \"const p=require('path');const f=p.join(__dirname,'reports','dashboard','index.html');console.log('Dashboard: '+f);\"",
    "pretest:full": "node --import tsx utils/cleanReports.ts",
    "test:full": "node --import tsx utils/runAllPlatforms.ts",
    "test:full-with-performance": "node --import tsx utils/runAllPlatforms.ts",
    "ci:full": "node --import tsx utils/runAllPlatforms.ts",
    "test:api:ai": "npm run test:api && node --import tsx utils/generateApiAiAnalysis.ts && node --import tsx ai/agents/apiAnalysisAgent.ts",
    "report:api": "node --import tsx -e \"const fs=require(\\\"fs-extra\\\");const p=require(\\\"path\\\");const files=[\\\"reports/api/api-summary.json\\\",\\\"reports/api/api-summary.md\\\",\\\"reports/api/api-report.html\\\",\\\"reports/ai/api-analysis-report.md\\\"];console.log(\\\"\\\\n=== API Report Summary ===\\\");let all=true;files.forEach(f=>{const ok=fs.existsSync(f);if(!ok)all=false;console.log((ok?\\\"✅\\\":\\\"❌\\\")+\\\" \\\"+f+(ok?\\\" (\\\"+fs.statSync(f).size+\\\" bytes)\\\":\\\" (MISSING)\\\"));});if(all){try{const j=JSON.parse(fs.readFileSync(\\\"reports/api/api-summary.json\\\"));console.log(\\\"\\\\nTotal: \\\"+j.totalAPIs+\\\" | Passed: \\\"+j.passed+\\\" | Failed: \\\"+j.failed+\\\" | Pass%: \\\"+j.passRate);}catch(e){console.log(\\\"\\\\nCould not parse summary JSON\\\");}}console.log(\\\"\\\");\"",
    "clean:api-reports": "node --import tsx -e \"const fs=require(\\\"fs-extra\\\");const dirs=[\\\"reports/api\\\",\\\"reports/ai/api-analysis-report.md\\\"];dirs.forEach(d=>{if(fs.existsSync(d)){fs.removeSync(d);console.log(\\\"Removed: \\\"+d);}});console.log(\\\"API reports cleaned.\\\");\"",
    "ai:api-analysis": "node --import tsx utils/generateApiAiAnalysis.ts",
    "ai:api-analysis-agent": "node --import tsx ai/agents/apiAnalysisAgent.ts",
    "report:dashboard": "node --import tsx utils/runAllSuitesAndGenerateDashboard.ts",
    "test:all:dashboard": "node --import tsx utils/cleanReports.ts && npm run test:web && npm run test:android && npm run test:ios && npm run test:api && npm run perf:jmeter && npm run report:dashboard",
    "test:all:dashboard:safe": "node --import tsx utils/runAllSuitesAndGenerateDashboard.ts",
    "ai:consolidated-report": "node --import tsx ai/agents/ConsolidatedReportAgent.ts",
    "report:dashboard:only": "node --import tsx utils/generateConsolidatedDashboard.ts",
    "lifecycle:report": "node --import tsx utils/generateAgentLifecycleReport.ts",
    "deps:graph": "node --import tsx utils/generateAgentDependencyGraph.ts",
    "coverage:report": "node --import tsx utils/generateAgentCoverageReport.ts",
    "obs:dashboard": "node --import tsx utils/generateObservabilityDashboard.ts",
    "test:all:ai": "node --import tsx utils/runAllPlatformsOrchestrator.ts",
    "test:all:ai-headed": "node --import tsx utils/runAllAiHeaded.ts",
    "pretest:all": "node --import tsx utils/cleanReports.ts",
    "test:web:headed": "HEADLESS=false TEST_PLATFORM=WEB REPORT_DIR=reports/web cucumber-js --config cucumber.js --tags @web --format summary; node --import tsx utils/generateReports.ts web",
    "test:ai:headed": "HEADLESS=false node --import tsx utils/runCucumberWithAi.ts",
    "test:headed:ai": "HEADLESS=false npm run test:ai",
    "dashboard:enterprise": "node --import tsx utils/generateEnterpriseDashboard.ts",
    "fix:macos-security": "node --import tsx scripts/disableMacOSMaliciousScriptWarning.ts",
    "jmeter": "npm run perf:jmeter",
    "performance:test": "npm run perf:jmeter",
    "test:performance": "npm run perf:jmeter",
    "report:ai-agents": "node --import tsx utils/generateAiAgentReport.ts",
    "ai:monitor": "node --import tsx utils/runAiAgentMonitor.ts"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "javascript",
    "pom",
    "amazon",
    "automation",
    "jmeter",
    "performance",
    "load-testing",
    "api-testing"
  ],
  "author": "Kumar Saurabh",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.56.1",
    "@types/cucumber-html-reporter": "^5.0.0",
    "@types/dotenv": "^6.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.0",
    "appium-xcuitest-driver": "^9.10.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "webdriverio": "^9.20.0",
    "winston": "^3.18.3"
  },
  "dependencies": {
    "chromadb": "^3.4.3"
  }
}
