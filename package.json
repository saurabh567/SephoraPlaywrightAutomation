{
  "name": "amazonwebmobileplaywrightautomation",
  "displayName": "AMAZONWEBMOBILEPLAYWRIGHTAUTOMATION",
  "version": "1.0.0",
  "description": "Industry-standard Playwright JavaScript Cucumber BDD automation framework for Amazon India UI. Includes JMeter performance testing with AI analysis and API automation module.",
  "main": "index.js",
  "scripts": {
    "pretest": "node utils/cleanReports.js",
    "test": "node utils/runCucumberWithAi.js",
    "pretest:core": "node utils/cleanReports.js",
    "test:core": "cucumber-js --config cucumber.js",
    "appium:start": "node ai/agents/AppiumAgent.js start",
    "appium:stop": "node ai/agents/AppiumAgent.js stop",
    "appium:status": "node ai/agents/AppiumAgent.js status",
    "pretest:web": "node utils/cleanReports.js --platform web",
    "test:web": "TEST_PLATFORM=WEB REPORT_DIR=reports/web cucumber-js --config cucumber.js --tags @web --format summary; node utils/generateReports.js web",
    "pretest:android": "node utils/cleanReports.js --platform android",
    "test:android": "node mobile/runAndroidWithOrchestrator.js",
    "test:android:legacy": "node utils/runAndroidWithLifecycle.js; node utils/generateReports.js android",
    "test:android:raw": "ENV_FILE=.env.android REPORT_DIR=reports/android PARALLEL=1 cucumber-js --config cucumber.js --tags @android --retry 1 --format summary",
    "pretest:ios": "node utils/cleanReports.js --platform ios",
    "test:ios": "node mobile/runIOSWithOrchestrator.js",
    "test:ios:legacy": "node utils/runIOSWithLifecycle.js; node utils/generateReports.js ios",
    "test:all": "node utils/runAllPlatforms.js; node utils/generateReports.js all",
    "test:ios:raw": "ENV_FILE=.env.ios REPORT_DIR=reports/ios PARALLEL=1 cucumber-js --config cucumber.js --tags @ios --format summary",
    "pretest:ai": "node utils/cleanReports.js",
    "test:ai": "node utils/runCucumberWithAi.js",
    "pretest:parallel": "node utils/cleanReports.js",
    "test:parallel": "PARALLEL=4 cucumber-js --config cucumber.js",
    "pretest:parallel:2": "node utils/cleanReports.js",
    "test:parallel:2": "PARALLEL=2 cucumber-js --config cucumber.js",
    "test:cross-browser": "node utils/runCrossBrowser.js",
    "test:cross-browser:smoke": "BROWSERS=chromium,firefox,webkit TAGS=@smoke node utils/runCrossBrowser.js",
    "test:home": "cucumber-js --config cucumber.js features/home.feature",
    "test:smoke": "cucumber-js --config cucumber.js --tags @smoke",
    "test:regression": "cucumber-js --config cucumber.js --tags @regression",
    "test:login": "cucumber-js --config cucumber.js --tags @login",
    "test:search-results": "cucumber-js --config cucumber.js features/search_results.feature",
    "test:cart": "cucumber-js --config cucumber.js features/cart.feature",
    "test:product": "cucumber-js --config cucumber.js features/product_details.feature",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "pretest:playwright:cli": "node utils/cleanReports.js",
    "test:playwright:cli": "PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.js",
    "test:playwright:cli:headed": "HEADLESS=false PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.js --headed",
    "test:playwright:cli:ci": "CI=true PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.js",
    "test:playwright:cli:debug": "PWDEBUG=1 PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.js --headed --timeout 300000",
    "test:playwright:cli:smoke": "TAGS=@smoke PLAYWRIGHT_CLI=true npx playwright test --config playwright.config.cli.js --grep @smoke",
    "test:playwright:cli:ai": "PLAYWRIGHT_CLI=true node utils/runCucumberWithAi.js",
    "test:playwright:cli:orchestrate": "PLAYWRIGHT_CLI=true node ai/orchestrator/unifiedOrchestrator.js --playwright-cli",
    "pretest:api": "node -e \"require('fs-extra').ensureDirSync('reports/api'); require('fs-extra').ensureDirSync('reports/ai');\"",
    "test:api": "cucumber-js --config cucumber.api.js",
    "test:api:report": "node -e \"const fs=require(\\\"fs-extra\\\");const p=require(\\\"path\\\");const files=[\\\"reports/api/api-summary.json\\\",\\\"reports/api/api-summary.md\\\",\\\"reports/api/api-report.html\\\",\\\"reports/ai/api-analysis-report.md\\\"];console.log(\\\"\\\\n=== API Reports ===\\\");files.forEach(f=>{const ok=fs.existsSync(f);console.log((ok?\\\"✅\\\":\\\"❌\\\")+\\\" \\\"+f+(ok?\\\" (\\\"+fs.statSync(f).size+\\\" bytes)\\\":\\\"\\\"));});console.log(\\\"\\\");\"",
    "test:all:with-api": "npm run test:web; npm run test:api; npm run perf:jmeter; npm run ai:jmeter-analysis; npm run dashboard:generate",
    "report": "node utils/generateReport.js",
    "report:web": "node utils/generateReports.js web",
    "report:android": "node utils/generateReports.js android",
    "report:ios": "node utils/generateReports.js ios",
    "report:all": "node utils/generateReports.js all",
    "validate:migration": "node utils/validateMigrationReferences.js",
    "vector:start": "node ai/vector-db/startChroma.js",
    "vector:stop": "node ai/vector-db/chromaServerManager.js stop",
    "vector:health": "node ai/health/unifiedHealth.js",
    "vector:ingest": "node ai/vector-db/ingest.js",
    "vector:search": "node ai/vector-db/search.js",
    "vector:test": "node ai/vector-db/vectorTest.js",
    "rag:test": "node ai/local/localRagTest.js",
    "ai:test": "node ai/vector-db/aiTest.js",
    "ai:analyze-failures": "node ai/local/localAnalyzeFailures.js",
    "ollama:start": "node ai/health/ollamaManager.js start",
    "ollama:stop": "node ai/health/ollamaManager.js stop",
    "ollama:status": "node ai/health/ollamaManager.js status",
    "ollama:pull-embed": "node -e \"require('./ai/health/ollamaManager').pullModelSync(process.env.OLLAMA_EMBEDDING_MODEL||'nomic-embed-text')\"",
    "ollama:pull-llm": "node -e \"require('./ai/health/ollamaManager').pullModelSync(process.env.OLLAMA_LLM_MODEL||'llama3.2:3b')\"",
    "ai:generate-tests": "node ai/vector-db/generateTests.js",
    "ai:heal-locators": "node ai/vector-db/healLocators.js",
    "ai:jenkins-rag": "node ai/vector-db/analyzeJenkinsFailure.js",
    "ai:testcases": "node ai/index.js --agent TestCaseGenerationAgent",
    "ai:feature": "node ai/index.js --agent FeatureFileGenerationAgent",
    "ai:steps": "node ai/index.js --agent StepDefinitionGenerationAgent",
    "ai:page": "node ai/index.js --agent PageObjectGenerationAgent",
    "ai:jenkins": "node ai/index.js --agent JenkinsBuildFailureAnalysisAgent",
    "ai:review": "node ai/index.js --agent PlaywrightCodeReviewAgent",
    "ai:heal": "node ai/index.js --agent SelfHealingAutomationAgent",
    "ai:all": "node ai/index.js --all",
    "ai:orchestrate": "node ai/orchestrator/unifiedOrchestrator.js",
    "ai:orchestrate:full": "node ai/orchestrator/unifiedOrchestrator.js --force-full",
    "ai:orchestrate:analysis": "node ai/orchestrator/unifiedOrchestrator.js --skip-multi-agent --skip-reporting",
    "ai:orchestrate:legacy": "node ai/orchestrator/orchestrator.js",
    "ai:full-auto": "node ai/orchestrator/fullAuto.js",
    "ai:self-heal": "node -e \"(async()=>{const a=require('./ai/agents/locatorHealingAgent'); if(a.run) {console.log(await a.run());} else if(a.suggestWithRag){console.log(await a.suggestWithRag());}})()\"",
    "ai:retry-fix-rerun": "node -e \"(async()=>{const a=require('./ai/agents/selfHealingAutomationAgent'); if(a.run){console.log(await a.run());} else {console.log('no-op');}})()\"",
    "ai:root-cause": "node -e \"(async()=>{const a=require('./ai/agents/rootCauseAnalysisAgent'); if(a.run){console.log(await a.run());} else {console.log('no-op');}})()\"",
    "ai:prepare-pr": "node -e \"(async()=>{const a=require('./ai/agents/prPreparationAgent'); if(a.prepare){console.log(await a.prepare({}));} else {console.log('no-op');}})()\"",
    "ai:jenkins-recover": "node -e \"(async()=>{const a=require('./ai/agents/jenkinsBuildFailureAnalysisAgent'); if(a.analyze){console.log(await a.analyze());} else {console.log('no-op');}})()\"",
    "chroma:start": "node ai/vector-db/chromaServerManager.js start",
    "chroma:stop": "node ai/vector-db/chromaServerManager.js stop",
    "chroma:status": "node ai/vector-db/chromaServerManager.js status",
    "perf:jmeter": "node scripts/runJMeter.js",
    "perf:jmeter:gui": "node scripts/runJMeter.js --gui",
    "perf:jmeter:kill": "pkill -f ApacheJMeter || true; pkill -f jmeter || true",
    "perf:jmeter:html": "node -e \"const p=require('path');const f=p.join(__dirname,'reports','jmeter','html','index.html');console.log('JMeter HTML report: '+f);\"",
    "ai:jmeter-analysis": "node ai/agents/jmeterPerformanceAnalysisAgent.js",
    "dashboard:generate": "node utils/runDashboard.js",
    "dashboard:open": "node -e \"const p=require('path');const f=p.join(__dirname,'reports','dashboard','index.html');console.log('Dashboard: '+f);\"",
    "test:full-with-performance": "npm run test:ai && npm run perf:jmeter && npm run ai:jmeter-analysis && npm run dashboard:generate",
    "ci:full": "npm run test:full-with-performance",
    "test:api:ai": "npm run test:api && node utils/generateApiAiAnalysis.js && node ai/agents/apiAnalysisAgent.js",
    "report:api": "node -e \"const fs=require(\\\"fs-extra\\\");const p=require(\\\"path\\\");const files=[\\\"reports/api/api-summary.json\\\",\\\"reports/api/api-summary.md\\\",\\\"reports/api/api-report.html\\\",\\\"reports/ai/api-analysis-report.md\\\"];console.log(\\\"\\\\n=== API Report Summary ===\\\");let all=true;files.forEach(f=>{const ok=fs.existsSync(f);if(!ok)all=false;console.log((ok?\\\"✅\\\":\\\"❌\\\")+\\\" \\\"+f+(ok?\\\" (\\\"+fs.statSync(f).size+\\\" bytes)\\\":\\\" (MISSING)\\\"));});if(all){try{const j=JSON.parse(fs.readFileSync(\\\"reports/api/api-summary.json\\\"));console.log(\\\"\\\\nTotal: \\\"+j.totalAPIs+\\\" | Passed: \\\"+j.passed+\\\" | Failed: \\\"+j.failed+\\\" | Pass%: \\\"+j.passRate);}catch(e){console.log(\\\"\\\\nCould not parse summary JSON\\\");}}console.log(\\\"\\\");\"",
    "clean:api-reports": "node -e \"const fs=require(\\\"fs-extra\\\");const dirs=[\\\"reports/api\\\",\\\"reports/ai/api-analysis-report.md\\\"];dirs.forEach(d=>{if(fs.existsSync(d)){fs.removeSync(d);console.log(\\\"Removed: \\\"+d);}});console.log(\\\"API reports cleaned.\\\");\"",
    "ai:api-analysis": "node utils/generateApiAiAnalysis.js",
    "ai:api-analysis-agent": "node ai/agents/apiAnalysisAgent.js",
    "report:dashboard": "node utils/runAllSuitesAndGenerateDashboard.js",
    "test:all:dashboard": "node utils/cleanReports.js && npm run test:web && npm run test:android && npm run test:ios && npm run test:api && npm run perf:jmeter && npm run test:ai && npm run report:dashboard",
    "test:all:dashboard:safe": "node utils/runAllSuitesAndGenerateDashboard.js",
    "ai:consolidated-report": "node ai/agents/ConsolidatedReportAgent.js",
    "report:dashboard:only": "node utils/generateConsolidatedDashboard.js",
    "lifecycle:report": "node utils/generateAgentLifecycleReport.js",
    "deps:graph": "node utils/generateAgentDependencyGraph.js",
    "coverage:report": "node utils/generateAgentCoverageReport.js",
    "obs:dashboard": "node utils/generateObservabilityDashboard.js",
    "test:all:ai": "node utils/runAllPlatformsOrchestrator.js",
    "test:all:ai-headed": "node utils/runAllAiHeaded.js",
    "pretest:all": "node utils/cleanReports.js"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "javascript",
    "pom",
    "amazon",
    "automation",
    "jmeter",
    "performance",
    "load-testing",
    "api-testing"
  ],
  "author": "Kumar Saurabh",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.56.1",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.0",
    "appium-xcuitest-driver": "^9.10.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "webdriverio": "^9.20.0",
    "winston": "^3.18.3"
  },
  "dependencies": {
    "chromadb": "^3.4.3"
  }
}
