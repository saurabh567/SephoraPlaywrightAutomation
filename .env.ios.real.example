# Real iPhone .ipa or installed-app example
ENV=dev
TEST_PLATFORM=IOS
IOS_AUTOMATION_MODE=REAL_DEVICE
APP_NAME=Amazon India iOS App
REPORT_DIR=reports/ios
TIMEOUT=60000
RETRIES=0
PARALLEL=1
APPIUM_PROTOCOL=http
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/
APPIUM_PATH=/
APPIUM_LOG_LEVEL=info
APPIUM_AUTO_START=true
APPIUM_AUTO_STOP=true
APPIUM_START_TIMEOUT=30000
APPIUM_LOG_PATH=mobile/logs/appium-server.log
DEVICE_NAME=iPhone
PLATFORM_VERSION=
UDID=real-device-udid
BROWSER_NAME=
APP_PATH=/absolute/path/to/Amazon.ipa
BUNDLE_ID=
NO_RESET=true
FULL_RESET=false
NEW_COMMAND_TIMEOUT=120
XCODE_ORG_ID=your-apple-team-id
XCODE_SIGNING_ID=iPhone Developer
UPDATED_WDA_BUNDLE_ID=com.yourcompany.WebDriverAgentRunner
WDA_LOCAL_PORT=8100
USE_NEW_WDA=false
AUTO_ACCEPT_ALERTS=true
SHOW_XCODE_LOG=false
