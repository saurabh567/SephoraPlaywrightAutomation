TEST_PLATFORM=ANDROID

# Appium configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/

# Android device / emulator
ANDROID_AVD_NAME=Pixel_9_Pro
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
ANDROID_AUTOMATION_NAME=UiAutomator2

# ════════════════════════════════════════════════════════════════════
# LOCK SCREEN AUTO-UNLOCK CONFIGURATION
# ════════════════════════════════════════════════════════════════════
# Unlock strategy: 'swipe' (default), 'pin', 'pattern', 'password', 'disabled'
APPIUM_UNLOCK_STRATEGY=locksettings

# PIN or password to use for unlock (default: 1234)
APPIUM_UNLOCK_KEY=1234

# Set to 'true' to skip Appium's auto-unlock entirely
APPIUM_SKIP_UNLOCK=false

# ════════════════════════════════════════════════════════════════════

# AVD lifecycle
KEEP_ANDROID_EMULATOR=false
KEEP_APPIUM_SERVER=false

# ════════════════════════════════════════════════════════════════════
# Amazon app under test (ANDROID_NATIVE mode)
# ════════════════════════════════════════════════════════════════════
# Option 1: Set APP_PATH to an APK file for automatic installation
#   e.g., APP_PATH=/Users/username/Downloads/amazon-app.apk
#
# Option 2: Keep APP_PATH empty and rely on a pre-installed app
#   The framework will verify the package is installed.
#   If not installed, you'll get actionable diagnostics.
#
# Option 3: Set BROWSER_NAME=Chrome for ANDROID_WEB mode
#   The framework will use Chrome instead of the native app.
#
# APP_PATH=
ANDROID_APP_PATH=
ANDROID_APP_PACKAGE=in.amazon.mShop.android.shopping
ANDROID_APP_ACTIVITY=com.amazon.mShop.home.HomeActivity

# Generic aliases for env.config.js and capabilities
APP_PACKAGE=in.amazon.mShop.android.shopping
# APP_ACTIVITY intentionally left blank for auto-detection
# APP_ACTIVITY=com.amazon.mShop.home.HomeActivity
DEVICE_NAME=Android Emulator

# Reset / fresh state
NO_RESET=false
FULL_RESET=false
ANDROID_NO_RESET=false
ANDROID_FULL_RESET=false

# Between-scenario cleanup
CLEAR_APP_DATA_BETWEEN_SCENARIOS=true
FORCE_ANDROID_CLEANUP=true

# ════════════════════════════════════════════════════════════════════
# APPLICATION INITIALIZER CONFIGURATION
# ════════════════════════════════════════════════════════════════════
# Controls the ApplicationInitializer behaviour after driver session creation.
# All settings default to 'true' if not set.
# ════════════════════════════════════════════════════════════════════

# Automatically select language on the language selection screen
AUTO_SELECT_LANGUAGE=true

# Default language to select (used as text-fallback)
DEFAULT_LANGUAGE=English

# Automatically skip onboarding / tutorial screens if present
AUTO_SKIP_ONBOARDING=true

# Automatically dismiss system permission dialogs (notification, storage, etc.)
AUTO_DISMISS_PERMISSIONS=true

# Automatically dismiss promotional popups and overlays
AUTO_DISMISS_PROMOTIONS=true

# Automatically dismiss app update dialogs (skip / remind later)
AUTO_DISMISS_UPDATES=true

# Automatically handle location permission prompts (deny / skip)
AUTO_DISMISS_LOCATION=true

# Automatically navigate to and verify the Amazon Home Dashboard
AUTO_NAVIGATE_TO_DASHBOARD=true

# Set to 'true' to execute the full login flow instead of skipping sign in
RUN_LOGIN_FLOW=false

# Timeout (ms) for dashboard to fully load after all dismissals
DASHBOARD_WAIT_TIMEOUT=45000

# Poll interval (ms) for checking dashboard readiness
DASHBOARD_POLL_INTERVAL=2000

# Timeout (ms) for each individual initialization step
APP_INIT_STEP_TIMEOUT=15000

# ════════════════════════════════════════════════════════════════════
# ENTERPRISE REFACTOR — NEW SETTINGS
# ════════════════════════════════════════════════════════════════════

# AVD name (REQUIRED — no hardcoded fallback)
# This is the source of truth. Both ANDROID_AVD and ANDROID_AVD_NAME
# are checked, with ANDROID_AVD taking priority.
ANDROID_AVD=Pixel_9_Pro

# Allow emulator snapshot save/load
# Default: false — pipeline always uses -no-snapshot-load -no-snapshot-save
# Set to 'true' to allow snapshot usage (faster subsequent boots)
ANDROID_ALLOW_SNAPSHOTS=false

# Emulator headless mode
# Controls whether the emulator GUI is visible
EMULATOR_HEADLESS=false
