TEST_PLATFORM=ANDROID

# Appium configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/

# Android device / emulator
ANDROID_AVD_NAME=Pixel_9_Pro
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
ANDROID_AUTOMATION_NAME=UiAutomator2

# AVD lifecycle (see runAndroidWithLifecycle.js)
KEEP_ANDROID_EMULATOR=false
KEEP_APPIUM_SERVER=false

# Amazon app under test
ANDROID_APP_PATH=
ANDROID_APP_PACKAGE=in.amazon.mShop.android.shopping
# APP_ACTIVITY is intentionally left blank — android.capabilities.js will
# auto-detect the launcher activity via ADB when not set. If detection fails,
# it falls back to: com.amazon.mShop.home.HomeActivity
ANDROID_APP_ACTIVITY=

# Generic aliases for env.config.js and capabilities
APP_PACKAGE=in.amazon.mShop.android.shopping
# APP_ACTIVITY is intentionally left blank — auto-detected at runtime
APP_ACTIVITY=
DEVICE_NAME=Android Emulator

# Reset / fresh state — ensures every test starts with clean browser cache
NO_RESET=false
FULL_RESET=false
ANDROID_NO_RESET=false
ANDROID_FULL_RESET=false
